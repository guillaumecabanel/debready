# Guarded: an install that aborted before mise.sh would otherwise make every
# new shell print an error.
command -v starship >/dev/null && eval "$(starship init zsh)"
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"

# mise is activated by the oh-my-zsh `mise` plugin (see plugins= in .zshrc),
# which also wires up its completions. Do not eval `mise activate` again here.

# Was unset, so git and friends fell back to whatever sensible-editor picked.
# vim is configured by dotfiles/vim (see install/vim.sh).
export EDITOR=vim
export VISUAL=vim

# Docker runs rootless (see install/docker.sh): the daemon is a `systemd --user`
# unit listening on this user's runtime dir, not root's /var/run/docker.sock.
# The `rootless` docker context already points the CLI there; this is for Go
# clients like lazydocker that only read the environment.
export DOCKER_HOST="unix://${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/docker.sock"
